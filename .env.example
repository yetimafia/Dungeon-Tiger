# Copy this file to .env and fill it in.

# The Dungeon Tiger bot's own token (a second Discord application, not Note Tiger's).
# Leave empty to use only the GM page.
DISCORD_TOKEN=

# Note Tiger → Settings → Connections: turn it on, then copy the address and key here.
NOTE_TIGER_URL=http://localhost:3081/v1
NOTE_TIGER_KEY=
# Which Discord server's characters, books and #recaps to use (its ID). Empty = Note Tiger's first server.
NOTE_TIGER_SERVER=

# D&D rules for new runs: 2024 or 2014
EDITION=2024

# The GM page: http://localhost:3090 (GM_LAN=true lets other computers on your network open it)
PORT=3090
GM_LAN=false

# Seconds a player gets to choose an action in Discord before the game plays the turn for them
TURN_SECONDS=120

# Random characters are removed from Note Tiger when the run ends. true = keep them.
KEEP_CHARACTERS=false
